GOOGLE_API_KEY=sk-ant-xxxxxxxxxxxx
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=change-me-min-32-chars

# 하루에 쓸 Gemini 호출 총량. 비우면 20(무료 티어 한도).
# 0으로 두면 모든 AI 기능이 꺼진다 — 급히 차단할 때 쓰는 스위치다.
AI_DAILY_TOTAL=20

# 그중 사용자 몫으로 떼어두는 양. 비우면 12.
# 백그라운드 스윕은 이 선 위(총량 - 예비선 = 8건)에서만 돈다. 예비선이 없으면
# 오전에 스윕이 한도를 다 먹고, 오후에 회의 녹음을 올린 사람이 소진을 만난다 —
# 시킨 일이 안 시킨 일 때문에 실패한다.
AI_BUDGET_RESERVE=12

# AI 호출 장부가 하루를 새로 세는 기준 시간대. 비우면 America/Los_Angeles.
# Gemini 문서상 RPD는 태평양 자정에 리셋된다. 여기를 UTC로 두면 KST 09:00에
# 장부만 0이 되고 실제 할당량은 KST 17시경까지 어제 것이라, 그 사이 화면은
# 쓸 수 있다고 하고 Gemini는 429를 준다. IANA 시간대 이름으로 적는다.
AI_BUDGET_RESET_TZ=America/Los_Angeles
